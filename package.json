{
	"name": "@proctorio/eslint-config",
	"version": "4.0.0",
	"type": "module",
	"files": [
		"index.js",
		"typescript.js",
		"rules/",
		"SECURITY.md",
		"security.txt"
	],
	"description": "Proctorio's opinionated ESLint configuration with strict JSDoc, Allman brace style, and tab indentation. Built for ESLint v10 flat config. Includes TypeScript support.",
	"main": "index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proctorio/eslint-config.js.git"
	},
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest watch"
	},
	"author": "Proctorio",
	"license": "Unlicense",
	"peerDependencies": {
		"eslint": "^10.4.0",
		"typescript-eslint": ">=8.56.0"
	},
	"peerDependenciesMeta": {
		"typescript-eslint": {
			"optional": true
		}
	},
	"dependencies": {
		"@eslint/js": "10.0.1",
		"eslint-plugin-belgradian": "2.4.6",
		"eslint-plugin-jsdoc": "65.2.0",
		"eslint-plugin-unicorn": "77.0.0",
		"globals": "17.13.0"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "5.0.3",
		"eslint": "10.12.0",
		"semver": "7.8.5",
		"typescript": "7.0.2",
		"typescript-eslint": "8.71.1",
		"vitest": "5.0.3"
	},
	"keywords": [
		"eslint",
		"eslintconfig",
		"eslint-config",
		"config",
		"proctorio",
		"javascript",
		"typescript",
		"styleguide",
		"jsdoc",
		"closure",
		"flat-config",
		"eslint10",
		"code-quality",
		"linting"
	],
	"engines": {
		"node": "^22.22.2 || >=24.15.0"
	},
	"exports": {
		".": "./index.js",
		"./typescript": "./typescript.js"
	}
}
